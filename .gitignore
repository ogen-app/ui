# Dependencies
node_modules
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Use pnpm (pnpm-lock.yaml). Block npm lockfile to prevent tooling drift.
package-lock.json

# Local env overrides (.env.example is tracked)
.env
.env.local
.env.*.local
.env.api

# Local-only Docker Compose overrides (machine-specific port/env tweaks)
docker-compose.override.yml

# TanStack Router plugin scratch space
.tanstack/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Claude Code local state (worktrees, settings)
.claude/

# Local admin helper for platform API keys (not for the repo)
scripts/set-secret.sh

# Logs
*.log
