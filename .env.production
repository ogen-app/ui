# Committed on purpose: what every deployed build (`vite build`, mode
# production) needs and nothing here is secret. `pnpm dev` and the tests do not
# load this file.

# The help centre's content (CON-173): getogen.com's Sanity project, read
# token-free from its public dataset. The app's origins are registered for CORS
# there without credentials; localhost is not, so `pnpm dev` serves the
# fixtures in `services/help/fixtures` instead.
VITE_SANITY_PROJECT_ID=s5ikqvpd
VITE_SANITY_DATASET=production
